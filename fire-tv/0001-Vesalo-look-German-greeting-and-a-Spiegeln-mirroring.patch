+    // Opens the first installed mirroring receiver; if none can be opened, says how to reach
+    // Fire TV's own one (hold Home, then Mirroring).
+    void mirror() {
+        for (String p : MIRROR) {
+            if (pm.getLeanbackLaunchIntentForPackage(p) == null && pm.getLaunchIntentForPackage(p) == null) continue;
+            String label = p;
+            try { label = pm.getApplicationLabel(pm.getApplicationInfo(p, 0)).toString(); } catch (Exception ignored) {}
+            launch(p, label);
+            return;
+        }
+        showCaption("Home-Taste gedrückt halten, dann „Spiegeln“ wählen");
+    }
