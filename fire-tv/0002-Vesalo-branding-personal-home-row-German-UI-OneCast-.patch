From 28d6e2feb1c23862b715de0ae349438203192798 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 10 Nov 2026 05:33:31 +0000
Subject: [PATCH 2/2] Vesalo branding, personal home row, German UI, OneCast
 mirroring

- App name "Vesalo", Vesalo icon and banner (from the Vesalo favicon)
- Home row defaults to Netflix, Prime Video, YouTube, DAZN, WOW, RTL+,
  Crunchyroll, matched by app name; everything else stays in the drawer
- White DAZN and RTL logos (Simple Icons, CC0)
- "Spiegeln" opens OneCast first, then AirScreen, then Fire TV's own
- All on-screen text in German

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014FhJRcyxwvLSScWmo4WMDD
---
 app/AndroidManifest.xml                    |   4 +-
 app/assets/logos/dazn.png                  | Bin 0 -> 3537 bytes
 app/assets/logos/rtl.png                   | Bin 0 -> 1138 bytes
 app/res/drawable-nodpi/banner.png          | Bin 8530 -> 5680 bytes
 app/res/drawable-nodpi/icon.png            | Bin 5731 -> 3616 bytes
 app/src/com/fireframe/home/HomeScreen.java |  64 +++++++++++++++------
 6 files changed, 48 insertions(+), 20 deletions(-)
 create mode 100644 app/assets/logos/dazn.png
 create mode 100644 app/assets/logos/rtl.png

diff --git a/app/AndroidManifest.xml b/app/AndroidManifest.xml
index 8e5cecd..032ffe4 100644
--- a/app/AndroidManifest.xml
+++ b/app/AndroidManifest.xml
@@ -19,7 +19,7 @@
     <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
     <uses-feature android:name="android.software.leanback" android:required="false" />
     <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
-    <application android:label="FireFrame" android:icon="@drawable/icon" android:banner="@drawable/banner"
+    <application android:label="Vesalo" android:icon="@drawable/icon" android:banner="@drawable/banner"
         android:allowBackup="false" android:hardwareAccelerated="true"
         android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
         <activity android:name=".MainActivity"
@@ -53,7 +53,7 @@
              FireFrame whenever it opens. Turned on by fireframe.sh install, off by fireframe.sh undo. -->
         <service android:name=".HomeService"
             android:exported="true"
-            android:label="FireFrame Home button"
+            android:label="Vesalo Home-Taste"
             android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
             <intent-filter>
                 <action android:name="android.accessibilityservice.AccessibilityService" />
